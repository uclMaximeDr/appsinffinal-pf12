<% styles=`
<link rel="stylesheet" href="styles/captcha.css">
` %>

<section class="pageContainer flex">
    <div class="container">
        <div class="captchaContainer">
            <div class="header">
                <h3>Veuillez sélectionner toutes les cases contenants :</h3>
                <h2><%= object %></h2>
            </div>
            <img src="<%= url %>" alt="" id="templateImage">
            <div class="imagePartContainer" id="imagePartContainer"></div>
            <button id="validate">Valider</button>
        </div>
        <div class="success hide">
            <img src="/images/captcha-success.svg">
            <p>Bravo, tu as mérité ta bierre !</p>
            <button id="next">Continue</button>
        </div>
        <div class="fail hide">
            <img src="/images/captcha-fail.svg">
            <p>Vous avez échoué, pas de bierre !</p>
            <button id="retry">Réessayer</button>
        </div>
    </div>
</section>

<script src="/scripts/captcha.js"></script>