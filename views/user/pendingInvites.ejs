<% styles = `
<link rel="stylesheet" href="/styles/pendingInvites.css">
` %>

<section class="pageContainer">

    <img src="/icons/leftarrow.svg" alt="Back icon" id="back" width="35px">
    
    <div class="inviteContainer">

        <% requests.forEach(request => { %>

            <div class="inviteElement">

                <img class="profilePicture" src="/api/user/profile-picture/<%= request.from_id %>" alt="Profile Picture">
                
                <span><%= request.user.fullname %></span>
                
                <div class="buttonContainer">
                    <button>Accept</button>
                    <button>Decline</button>
                </div>
            </div>

        <% }) %>

    </div>

    <script src="/scripts/pendingInvites.js"></script>
</body>
</html>