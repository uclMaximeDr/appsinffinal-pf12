<%
styles = `
<link rel="stylesheet" href="/styles/useredit.css" />
`
%>

<section class="pageContainer flex">
  <div class="editContainer">
    <img src="/icons/leftarrow.svg" alt="Back icon" id="back">
    
    <div class="profile">
        <div class="profilePictureContainer">
            <input type="file" id="profilePictureInput" class="hidden" />
            <img class="profilePicture" src="/api/user/profile-picture/me">
            <div class="hover">
                <svg xmlns="http://www.w3.org/2000/svg" width="25" height="25" fill="currentColor" id="editButton" viewBox="0 0 16 16">
                    <path d="M12.854.146a.5.5 0 0 0-.707 0L10.5 1.793 14.207 5.5l1.647-1.646a.5.5 0 0 0 0-.708zm.646 6.061L9.793 2.5 3.293 9H3.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.207zm-7.468 7.468A.5.5 0 0 1 6 13.5V13h-.5a.5.5 0 0 1-.5-.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.5-.5V10h-.5a.5.5 0 0 1-.175-.032l-.179.178a.5.5 0 0 0-.11.168l-2 5a.5.5 0 0 0 .65.65l5-2a.5.5 0 0 0 .168-.11z"/>
                </svg>
            </div>
        </div>
    </div>
    <div class="menu">
      <div class="menu-item">
        <label for="email">Username</label>
        <input type="text" id="username" value="<%- username %>"/>
      </div>
      <div class="menu-item">
        <label for="email">Email</label>
        <input type="text" id="email" value="<%- email %>"/>
      </div>
      <div class="menu-item">
      <label for="password">Nouveau mot de passe</label>
      <input type="password" id="password" />
    </div>
    <div class="menu-item">
      <button id="submit">Enregistrer</button>
    </div>
  </div>
</section>

<script src="/scripts/useredit.js"></script>