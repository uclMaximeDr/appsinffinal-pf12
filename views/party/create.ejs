<% styles=`
<link rel="stylesheet" href="/styles/create.css">`
%>
<img src="/icons/leftarrow.svg" alt="Back icon" id="back" width="35px">
<div class="pageContainer flex">
    <div class="content">
        
        <div class="data-box">
            <span><button id = "location" onclick="getLocation()">Utiliser ma position</button></span>
            <p id="demo"></p>
            <% if (id_saved && data_party) {%>
                <h1>Tu souhaites modifier ta soirée ? Pas de problème !</h1>
                <input class="party_line" id="party_address" type="text" placeholder="Modification Adresse*" value="<%= data_party.address%>">

                <input class="party_line" id="party_title" type="text" placeholder="Modification Titre*" value="<%= data_party.title%>">
                <!-- Mode Raid -->
                
                <label class="containerRaid"> Mode raid
                    <!-- raid ? StackOverflow-->
                    <input type="checkbox" id="party_raid" <%= data_party.raid ? 'checked' : '' %>>
                    <span class="checkmark">: Ajoute votre soirée au tirage aléatoire de 19h pour attirer plus de fêtards chez vous.</span> 
                </label>
                
                <textarea class="party_input" id="party_description" name="data_party" placeholder="C'est quoi les nouveautés de ta soirée !?* </span>" rows="10" cols="60"><%= data_party.description %></textarea>


            <%} else {%>
                <h1>On va crée une soirée ensemble !</h1>
                <input class="party_line" id="party_address" type="text" placeholder="Adresse*">
                <input class="party_line" id="party_title" type="text" placeholder="Titre*">

                <!-- Mode Raid -->
                <label class="party_raid"> Mode raid 
                    <input type="checkbox" id="party_raid">
                    <span class="checkmark">: Ajoute votre soirée au tirage aléatoire de 19h pour attirer plus de fêtards chez vous.</span> 
                </label>

                <textarea class="party_input" id="party_description" name="data_party" placeholder="Donne nous une description de ta soirée !*" rows="10" cols="60"></textarea>

            <%}%>

            <button id="party_submit">Poster</button>

        </div>

        <div class="rulesContainer">
            <h2>FindMyParty - Règles</h2>
            <div class="rules">
                <p>1. Ne postez pas de soirée qui ne sont pas les votres.</p>
                <p>2. Soyez courtois et polis.</p>
                <p>3. Évitez tous débat politique. </p>
                <p>4. Pas de pub perso ou quelconques. </p>
                <p>5. Merci de ne pas perturber la discussion en organisant des raids, en propageant la haine ou en votant négativement sur tout le monde.</p>
                <p>6. Aucune pornographie ou nudité d'aucune sorte.</p>
                <p>7. Amusez-vous un maximum !</p>
            </div>
        </div>
    </div>
</div>
<script src="/scripts/index.js"></script>
<script src="/scripts/party.js"></script>
