<% styles=`
<link rel="stylesheet" href="/styles/party.css">`
%>
<div class="leftPanel">

</div>

<div class="rightPanel">

    <div class="data-box">

        <div class="user-info">
            <img src="/images/default_user.png" alt="user">
            <p><%= party.username %></p>

            <h4><strong><span id="party-address"><%= party.address %></span></strong></h4>
        </div>

        <h2><strong></strong> <%= party.title %></h2>
        <p><strong> <%= party.description %></strong></p>
        <br>

        <textarea class="party_input" id="comment_data" placeholder="Poster ton avis" rows="2" cols="60"></textarea>
        <div class = "subbar-input">
            <td><button class="UpDown" id ="up"> 0 ^ </button></td>
            <td><button class="UpDown" id ="down">0 v </button></td>
            <td><button class="button-comment" id ="share"> Share </button></td>
            <td><button class="button-comment" id="comment_post" data-party_id = "<%= party._id%>" > Poster </button></td>

        </div>


        <div class="comment">
            <% if (comments && comments.length != 0) { %>
                <% comments.forEach(user_comment =>{%>
                    <p><%= user_comment.comment %></p>
                <%})%>
            <%} else { %>
                <p>Pas de commentaire.</p>
            <%} %>
        </div>

        

    </div>


</div>

<script src="/scripts/party.js"></script>