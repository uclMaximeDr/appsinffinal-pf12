<% styles=`
<link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css" />
<link rel="stylesheet" href="styles/index.css">`
%>

<section class="pageContainer">
    <div class="sidebar">

        <input type="search" placeholder="Search...">
        <div class="selectorContainer" id="searchSelector">
            <div class="selector left"></div>
            <div class="options">
                <p>Tous</p>
                <p>Amis</p>
            </div>
        </div>

        <div class = "cardContainer">
        <%parties.forEach(party =>{%>
            <div class = "cardParty">
                <h3><%= party.title %></h3>
                <h4>Posté par <%= party.user.fullname %></h4>
                <h5>Lieu : <%= party.address %></h5>
                <p><%= party.description %></p>
                <a href="/party/<%= party._id %>">Détails</a>
            </div>
        <%})%>
        </div>
    </div>
    
    <div id="map"></div>
    <div class="links">
        <a href="/user/login" title="Gestion du compte">
            <img src="/icons/user.svg" alt="User icon" />
        </a>
        <a href="/camera" title="Prendre une photo!">
            <img src="/icons/camera.svg" alt="Camera icon">
        </a>
        <a href="/party/create" title="Ajouter une soirée!">
            <img src="/icons/add.svg" alt="Add icon">
        </a>
    </div>
</section>

<script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>
<script>
function randomCoords() { // Generate random coordinates near LLN
    return {
        lat: 50.6689126 + (Math.random() - 0.5) * 0.01,
        lng: 4.6150577 + (Math.random() - 0.5) * 0.01
    };
}
const markers = <%- JSON.stringify(parties.map(party => ({ lat: party.latitude, lng: party.longitude, img: party.image }))) %>;
markers.map(marker => {
    if(!marker.img) {
        marker.img = "/images/casa.jpeg";
    }
    if(!marker.lat || !marker.lng) {
        const coords = randomCoords();
        marker.lat = coords.lat;
        marker.lng = coords.lng;
    }
});
</script>
<script src="/scripts/index.js"></script>