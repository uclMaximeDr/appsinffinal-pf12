<% styles=`
<link rel="stylesheet" href="styles/camera.css">
` %>

<section class="pageContainer">

    <img src="/icons/leftarrow.svg" alt="Back icon" id="back" width="35px">
    
    <video id="camera" autoplay muted></video>
    <div class="error">
        <h1 class="nocamera">Pas de caméra disponible</h1>
        <h1 class="nogps">Pas de GPS disponible</h1>
    </div>
    <div class="takeOverlay take"></div>
    <div class="controls">
        <button id="takePicture">Take picture</button>
    </div>
    
    <script src="/scripts/camera.js"></script>
</section>